  , regexp_substr(********.tickets.subject,'\\d{6}-\\w{4}') as title
  , case when contains(********.tickets.********,'********_cardname') or contains(********.tickets.********,'********_card') then 'card' end as card_tag
  , case when contains(********.tickets.********,'********_quantity') then 'qty' end as qty_tag
  , case when contains(********.tickets.********,'********_package') or contains(********.tickets.********,'********') then 'pkg' end as pkg_tag
