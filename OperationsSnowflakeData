##PVP SQ Data
sq_sql = ("""
select
    distinct category.categoryname as game_name
    , ********order.********ordernumber as order_number
    , shippingqueue.shippingqueuenumber as shipping_queue_number

from
********.********.********order
inner join ********.********.shippingqueue on ********order.shippingqueueid = shippingqueue.shippingqueueid
inner join ********.********.sellerorder on ********order.orderid = sellerorder.orderid
inner join ********.********.sellerorderproduct on sellerorder.sellerorderid = sellerorderproduct.sellerorderid
inner join ********.********.productcondition on sellerorderproduct.storeproductconditionid = productcondition.productconditionid
inner join ********.********.product on productcondition.productid = product.productid
inner join ********.********.category on product.categoryid = category.categoryid

where
    ********order.createdat::date >= cast(dateadd(dd, -150, getdate()) as date)
    and ((game_name = 'Magic') or (game_name = 'Pokemon') or (game_name = 'YuGiOh'))

order by
    order_number
    , shipping_queue_number
    , game_name

""")

cursor = snowflake_pull.cursor()
cursor.execute(sq_sql)

sq_df = cursor.fetch_pandas_all()

sq_df.drop(sq_df.filter(like='Unnamed'), axis=1, inplace=True)
sq_df.dropna(subset=['ORDER_NUMBER'], inplace=True)

sq_df['SHIPPING_QUEUE_NUMBER'] = sq_df['SHIPPING_QUEUE_NUMBER'].str.lower()

sq_df.rename(columns={'SHIPPING_QUEUE_NUMBER':'Subtask'}, inplace=True)

##Create csv
