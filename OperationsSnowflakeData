##PVP SQ Data
sq_sql = ("""
select
    distinct category.******** as game_name
    , directorder.******** as order_number
    , shippingqueue.******** as shipping_queue_number

from
********.directorder
inner join ********.shippingqueue on directorder.******** = shippingqueue.********
inner join ********.sellerorder on directorder.******** = sellerorder.********
inner join ********.sellerorderproduct on sellerorder.******** = sellerorderproduct.********
inner join ********t.productcondition on sellerorderproduct.******** = productcondition.********
inner join ********.product on productcondition.******** = product.********
inner join ********.category on product.******** = category.********

where
    directorder.createdat::date >= cast(dateadd(dd, -150, getdate()) as date)
    and ((game_name = 'Magic') or (game_name = 'Pokemon') or (game_name = 'YuGiOh'))

order by
    order_number
    , shipping_queue_number
    , game_name

""")

cursor = snowflake_pull.cursor()
cursor.execute(sq_sql)

sq_df = cursor.fetch_pandas_all()

sq_df.drop(sq_df.filter(like='Unnamed'), axis=1, inplace=True)
sq_df.dropna(subset=['ORDER_NUMBER'], inplace=True)

sq_df['SHIPPING_QUEUE_NUMBER'] = sq_df['SHIPPING_QUEUE_NUMBER'].str.lower()

sq_df.rename(columns={'SHIPPING_QUEUE_NUMBER':'Subtask'}, inplace=True)

##Create csv
